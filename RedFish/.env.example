# Copy this file as .env and replace the example credentials locally.
APP_IMAGE=redfish-app:local
APP_PORT=8080
MYSQL_PORT=3307

MYSQL_DATABASE=redfish
MYSQL_USER=redfish_user
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_root_password

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL=INFO
