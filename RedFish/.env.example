# Development example. QA and production have their own example files.
COMPOSE_PROJECT_NAME=redfish-develop
SPRING_PROFILES_ACTIVE=develop

APP_IMAGE=redfish-app:mvp2
APP_PORT=8080
APP_MEMORY_LIMIT=768M

MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3307
MYSQL_MEMORY_LIMIT=768M
MYSQL_VOLUME_NAME=redfish-develop-mysql-data
NETWORK_NAME=redfish-develop-network

MYSQL_DATABASE=redfish
MYSQL_USER=redfish_user
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_root_password

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL=INFO
