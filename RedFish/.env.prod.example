# Local production-like example. Do not expose MySQL in a real production host.
COMPOSE_PROJECT_NAME=redfish-prod
SPRING_PROFILES_ACTIVE=prod

APP_IMAGE=redfish-app:mvp2
APP_PORT=8082
APP_MEMORY_LIMIT=1G

MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3309
MYSQL_MEMORY_LIMIT=1G
MYSQL_VOLUME_NAME=redfish-prod-mysql-data
NETWORK_NAME=redfish-prod-network

MYSQL_DATABASE=redfish
MYSQL_USER=redfish_prod_user
MYSQL_PASSWORD=change_me_prod_password
MYSQL_ROOT_PASSWORD=change_me_prod_root_password

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL=WARN
