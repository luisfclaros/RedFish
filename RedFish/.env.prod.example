# Local production-like example. Do not expose MySQL in a real production host.
COMPOSE_PROJECT_NAME=redfish-prod
SPRING_PROFILES_ACTIVE=prod

APP_IMAGE=redfish-app:mvp2
APP_PORT=8082
APP_MEMORY_LIMIT=1G

MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3309
MYSQL_MEMORY_LIMIT=1G
MYSQL_VOLUME_NAME=redfish-prod-mysql-data
NETWORK_NAME=redfish-prod-network

MYSQL_DATABASE=redfish
MYSQL_USER=redfish_prod_user
MYSQL_PASSWORD=change_me_prod_password
MYSQL_ROOT_PASSWORD=change_me_prod_root_password

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL=WARN

# Initial administrator. Replace with a strong unique password before deployment.
REDFISH_BOOTSTRAP_ADMIN_USERNAME=admin
REDFISH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_password
REDFISH_BOOTSTRAP_ADMIN_NAME=Administrador RedFish

# Independent accounts for each RedFish area. Use unique passwords (minimum 10 characters).
REDFISH_BOOTSTRAP_PRODUCTION_USERNAME=production
REDFISH_BOOTSTRAP_PRODUCTION_PASSWORD=change_me_production_password
REDFISH_BOOTSTRAP_PRODUCTION_NAME=Usuario Producción
REDFISH_BOOTSTRAP_OPERATIONS_USERNAME=operations
REDFISH_BOOTSTRAP_OPERATIONS_PASSWORD=change_me_operations_password
REDFISH_BOOTSTRAP_OPERATIONS_NAME=Usuario Operaciones
REDFISH_BOOTSTRAP_COMMERCIAL_USERNAME=commercial
REDFISH_BOOTSTRAP_COMMERCIAL_PASSWORD=change_me_commercial_password
REDFISH_BOOTSTRAP_COMMERCIAL_NAME=Usuario Comercial
